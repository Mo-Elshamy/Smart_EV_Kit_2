<?xml version="1.0"?>
<robot name="ev_buggy" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================================================================== -->
  <!-- ROOT COORDINATE FRAME (REP-105)                                       -->
  <!-- base_link: Rear axle center projected down to the ground plane       -->
  <!-- ===================================================================== -->
  <link name="base_link"/>

  <!-- Include rigid sensor mount transforms -->
  <xacro:include filename="$(find ev_description)/urdf/sensor_mounts.xacro"/>

</robot>
