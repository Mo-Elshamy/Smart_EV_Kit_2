<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ev_localization</name>
  <version>1.0.0</version>
  <description>Localization and SLAM package for Smart EV Buggy (robot_localization EKF and slam_toolbox)</description>
  <maintainer email="student@smart-ev.local">Smart EV Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_localization</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ev_description</exec_depend>
  <exec_depend>ev_bringup</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
