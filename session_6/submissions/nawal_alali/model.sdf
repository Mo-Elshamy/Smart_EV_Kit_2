<?xml version="1.0"?>
<sdf version="1.8">
  <model name="waffle">
    <pose>0 0 0 0 0 0</pose>

    <!--
      IMPORTANT: every link <pose> below is relative to the MODEL origin
      (base_footprint, on the ground). In SDF a joint <pose> does NOT move the
      child link - always place a link with its own <pose>.
    -->

    <link name="base_footprint">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-6</iyy><iyz>0</iyz><izz>1e-6</izz></inertia>
      </inertial>
    </link>

    <link name="base_link">
      <pose>0 0 0.010 0 0 0</pose>
      <inertial>
        <pose>-0.064 0 0.048 0 0 0</pose>
        <mass>1.3729096</mass>
        <inertia>
          <ixx>4.2111447e-02</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>4.2111447e-02</iyy><iyz>0</iyz>
          <izz>7.5254874e-02</izz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <pose>-0.064 0 0.048 0 0 0</pose>
        <geometry><box><size>0.265 0.265 0.089</size></box></geometry>
      </collision>
      <visual name="base_visual">
        <pose>-0.064 0 0.048 0 0 0</pose>
        <geometry><box><size>0.265 0.265 0.089</size></box></geometry>
        <material>
          <ambient>0.25 0.25 0.25 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="wheel_left_link">
      <pose>0 0.144 0.033 -1.5708 0 0</pose>
      <inertial>
        <mass>0.0285</mass>
        <inertia><ixx>1.1e-05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.1e-05</iyy><iyz>0</iyz><izz>2.0e-05</izz></inertia>
      </inertial>
      <collision name="wheel_left_collision">
        <geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="wheel_left_visual">
        <geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>

    <link name="wheel_right_link">
      <pose>0 -0.144 0.033 -1.5708 0 0</pose>
      <inertial>
        <mass>0.0285</mass>
        <inertia><ixx>1.1e-05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.1e-05</iyy><iyz>0</iyz><izz>2.0e-05</izz></inertia>
      </inertial>
      <collision name="wheel_right_collision">
        <geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="wheel_right_visual">
        <geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>

    <link name="caster_back_left_link">
      <pose>-0.177 0.064 0.005 0 0 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia><ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-6</iyy><iyz>0</iyz><izz>1e-6</izz></inertia>
      </inertial>
      <collision name="caster_back_left_collision">
        <geometry><sphere><radius>0.005</radius></sphere></geometry>
        <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
      </collision>
    </link>

    <link name="caster_back_right_link">
      <pose>-0.177 -0.064 0.005 0 0 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia><ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-6</iyy><iyz>0</iyz><izz>1e-6</izz></inertia>
      </inertial>
      <collision name="caster_back_right_collision">
        <geometry><sphere><radius>0.005</radius></sphere></geometry>
        <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
      </collision>
    </link>

    <link name="imu_link">
      <pose>0 0 0.078 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-6</iyy><iyz>0</iyz><izz>1e-6</izz></inertia>
      </inertial>
      <sensor name="tb3_imu" type="imu">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <topic>imu</topic>
        <gz_frame_id>imu_link</gz_frame_id>
      </sensor>
    </link>

    <link name="base_scan">
      <pose>-0.064 0 0.132 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-6</iyy><iyz>0</iyz><izz>1e-6</izz></inertia>
      </inertial>
      <sensor name="hls_lfcd_lds" type="gpu_lidar">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>10</update_rate>
        <topic>scan</topic>
        <gz_frame_id>base_scan</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1.0</resolution>
              <min_angle>0.0</min_angle>
              <max_angle>6.28</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>3.5</max>
            <resolution>0.015</resolution>
          </range>
        </lidar>
      </sensor>
    </link>

    <link name="camera_link">
      <pose>0.064 -0.065 0.104 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-6</iyy><iyz>0</iyz><izz>1e-6</izz></inertia>
      </inertial>
    </link>

    <link name="camera_rgb_frame">
      <pose>0.069 -0.047 0.117 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-6</iyy><iyz>0</iyz><izz>1e-6</izz></inertia>
      </inertial>
      <sensor name="camera" type="camera">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>30</update_rate>
        <topic>camera/image_raw</topic>
        <gz_frame_id>camera_rgb_frame</gz_frame_id>
        <camera name="intel_realsense_r200">
          <camera_info_topic>camera/camera_info</camera_info_topic>
          <horizontal_fov>1.02974</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>300</far>
          </clip>
        </camera>
      </sensor>

      <!-- Depth Camera -->
      <sensor name="depth_camera" type="rgbd_camera">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>15</update_rate>
        <topic>depth_camera</topic>
        <gz_frame_id>camera_rgb_frame</gz_frame_id>

        <camera name="depth_camera">
          <horizontal_fov>1.02974</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>10.0</far>
          </clip>
        </camera>
      </sensor>
    </link>

    <!-- camera_rgb_optical_frame exists only in urdf/waffle.urdf (TF only, no Gazebo body needed) -->

    <joint name="base_joint" type="fixed">
      <parent>base_footprint</parent>
      <child>base_link</child>
    </joint>


    
<!-- GNSS Fixed Joint -->
<joint name="gps_joint" type="fixed">
  <parent>base_link</parent>
  <child>gps_link</child>
</joint>



    <joint name="wheel_left_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_left_link</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>

    <joint name="wheel_right_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_right_link</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>

    <joint name="caster_back_left_joint" type="fixed">
      <parent>base_link</parent>
      <child>caster_back_left_link</child>
    </joint>

    <joint name="caster_back_right_joint" type="fixed">
      <parent>base_link</parent>
      <child>caster_back_right_link</child>
    </joint>

    <joint name="imu_joint" type="fixed">
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>

    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>base_scan</child>
    </joint>

    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <joint name="camera_rgb_joint" type="fixed">
      <parent>camera_link</parent>
      <child>camera_rgb_frame</child>
    </joint>


    <!-- TODO (Step 4): add gps_link (with its own <pose>), navsat sensor and a fixed joint to base_link -->

<!-- GNSS Sensor -->
<link name="gps_link">
  <pose>-0.05 0 0.20 0 0 0</pose>
  <inertial>
    <mass>0.001</mass>
    <inertia>
      <ixx>1e-6</ixx>
      <ixy>0</ixy>
      <ixz>0</ixz>
      <iyy>1e-6</iyy>
      <iyz>0</iyz>
      <izz>1e-6</izz>
    </inertia>
  </inertial>

  <sensor name="gps" type="navsat">
    <always_on>true</always_on>
    <update_rate>5</update_rate>
    <topic>navsat</topic>
    <gz_frame_id>gps_link</gz_frame_id>
  </sensor>
</link>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <tf_topic>/tf</tf_topic>
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.287</wheel_separation>
      <wheel_radius>0.033</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <odom_publisher_frequency>30</odom_publisher_frequency>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>wheel_left_joint</joint_name>
      <joint_name>wheel_right_joint</joint_name>
    </plugin>

  </model>
</sdf>
