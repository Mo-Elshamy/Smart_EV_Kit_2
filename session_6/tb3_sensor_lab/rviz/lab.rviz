Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/TF/TF
      Name: TF
      Enabled: true
      Show Arrows: true
      Show Axes: true
    - Class: rviz_default_plugins/LaserScan/LaserScan
      Name: LaserScan
      Enabled: true
      Topic: /scan
      Selectable: true
    - Class: rviz_default_plugins/Image/Image
      Name: RGB Image
      Enabled: true
      Topic: /camera/image_raw
    - Class: rviz_default_plugins/PointCloud2/PointCloud2
      Name: Depth PointCloud
      Enabled: false
      Topic: /camera/depth/points
  Global Options:
    Fixed Frame: odom
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
