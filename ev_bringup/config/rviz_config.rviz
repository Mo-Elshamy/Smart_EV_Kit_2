Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground Grid
      Enabled: true
      Plane: XY
      Cell Size: 1.0
      Plane Cell Count: 20
      Color: 160; 160; 164
    - Class: rviz_default_plugins/RobotModel
      Name: Smart EV Buggy Model
      Enabled: true
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Name: Vehicle Coordinate Frames (TF)
      Enabled: true
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Marker Scale: 0.3
      Update Interval: 0.0
    - Class: rviz_imu_plugin/Imu
      Name: WT901 IMU Orientation
      Enabled: true
      Topic:
        Value: /imu/data
        Depth: 5
        Durability Policy: Volatile
      Enable Axes: true
      Enable Acceleration: false
      Scale: 0.5
    - Class: rviz_default_plugins/LaserScan
      Name: Raw Scan
      Enabled: false
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
      Size (m): 0.02
      Color: 255; 80; 80
      Color Transformer: FlatColor
      Selectable: true
    - Class: rviz_default_plugins/LaserScan
      Name: Filtered Scan (LiDAR)
      Enabled: true
      Topic:
        Value: /scan_filtered
        Depth: 5
        Durability Policy: Volatile
      Size (m): 0.04
      Color: 0; 255; 200
      Color Transformer: FlatColor
      Selectable: true
    - Class: rviz_default_plugins/Image
      Name: ZED RGB Image
      Enabled: true
      Topic:
        Value: /zed/zed_node/rgb/color/rect/image
        Depth: 5
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Image
      Name: ZED Depth Image
      Enabled: true
      Topic:
        Value: /zed/zed_node/image/depth_image
        Depth: 5
        Durability Policy: Volatile
    - Class: rviz_default_plugins/PointCloud2
      Name: ZED 3D PointCloud
      Enabled: true
      Topic:
        Value: /zed/zed_node/point_cloud/cloud_registered
        Depth: 5
        Durability Policy: Volatile
      Size (m): 0.02
      Style: Points
      Color Transformer: RGB8
      Selectable: true
    - Class: rviz_default_plugins/Odometry
      Name: Fused Odometry (EKF)
      Enabled: true
      Topic:
        Value: /odometry/filtered
        Depth: 5
        Durability Policy: Volatile
      Shape: Arrow
      Color: 255; 215; 0
      Keep: 100
      Length: 0.6
    - Class: rviz_default_plugins/Odometry
      Name: ZED Visual Odometry
      Enabled: false
      Topic:
        Value: /zed/zed_node/odom
        Depth: 5
        Durability Policy: Volatile
      Shape: Arrow
      Color: 0; 180; 255
      Keep: 100
      Length: 0.4
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4.5
      Focal Point:
        X: 0.6
        Y: 0.0
        Z: 0.4
      Pitch: 0.5
      Yaw: 0.8
